# Neon, branch principal. Copie para app/.env.local (ignorado pelo Git).
# Na Vercel, use a connection string com pooling (host com -pooler).
DATABASE_URL=postgres://usuario:senha@host/db?sslmode=require

# Autenticação (Better Auth). Gere o segredo com: npx auth@latest secret
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
BETTER_AUTH_URL=http://localhost:3000

# E-mail (Gmail com senha de app). Sem estas variáveis, em desenvolvimento o link aparece no console do servidor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Banco descartável para testes. Nunca apontar para a branch principal.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/opex_test?sslmode=disable
